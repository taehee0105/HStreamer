// multi_thread_server.c
#define _GNU_SOURCE

/**
 * Multithreaded, non-blocking HTTPS file server (HTTP/1.1 close)
 *
 * 설계 개요
 *  - 단일 acceptor 스레드가 신규 연결을 받고 라운드로빈으로 워커 큐에 전달
 *  - 각 워커는 EPOLLET 기반 상태머신(핸드셰이크→요청읽기→헤더→파일→종료)
 *  - 전송 모드는 컴파일 타임에 하나만 선택
 *      TLS_MODE_OPENSSL / TLS_MODE_KTLS_WRITE / TLS_MODE_KTLS_SENDFILE
 *
 * 빌드:
 *  gcc -O2 -pthread -Wall -Wextra -DTLS_MODE_OPENSSL -o epoll_multi_thread_server epoll_multi_thread_server.c -lssl -lcrypto
 *  gcc -O2 -pthread -Wall -Wextra -DTLS_MODE_KTLS_WRITE -DOPENSSL_KTLS=1 -o epoll_multi_thread_server epoll_multi_thread_server.c -lssl -lcrypto
 *  gcc -O2 -pthread -Wall -Wextra -DTLS_MODE_KTLS_SENDFILE -DOPENSSL_KTLS=1 -o epoll_multi_thread_server epoll_multi_thread_server.c -lssl -lcrypto
 */

#include <arpa/inet.h>
#include <ctype.h>
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <limits.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <pthread.h>
#include <sched.h>
#include <signal.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/epoll.h>
#include <sys/sendfile.h>
#include <sys/socket.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <time.h>
#include <unistd.h>

#include <openssl/err.h>
#include <openssl/ssl.h>

/** 단 하나의 모드만 허용 **/
#if (defined(TLS_MODE_OPENSSL) + defined(TLS_MODE_KTLS_WRITE) + defined(TLS_MODE_KTLS_SENDFILE)) != 1
# error "Define exactly one TLS_MODE_*"
#endif

#ifdef TLS_MODE_OPENSSL
# define MODE_NAME "OpenSSL(SSL_write)"
#endif
#ifdef TLS_MODE_KTLS_WRITE
# define MODE_NAME "kTLS(write)"
#endif
#ifdef TLS_MODE_KTLS_SENDFILE
# define MODE_NAME "kTLS(sendfile)"
#endif

/** 상수/전역 **/
#define MAX_WORKERS 128
#define MAX_EVENTS  256
#define REQ_BUFSZ   8192
#define IO_BUFSZ    (128 * 1024)

static volatile sig_atomic_t g_stop = 0;

/** 시그널 **/
static void on_sigint(int sig) {
    (void)sig;
    g_stop = 1;
}

/** 논블로킹 */
static int set_nonblock(int fd) {
    int fl = fcntl(fd, F_GETFL, 0);
    if (fl < 0) {
        return -1;
    }
    return fcntl(fd, F_SETFL, fl | O_NONBLOCK);
}

/** die */
static void die(const char *m) {
    perror(m);
    exit(1);
}

static void die_ssl(const char *m) {
    fprintf(stderr, "[SSL] %s\n", m);
    ERR_print_errors_fp(stderr);
    exit(1);
}

/** URL 디코드 */
static size_t url_decode(char *s) {
    char *src = s;
    char *dst = s;

    while (*src) {
        if (src[0] == '%' &&
            isxdigit((unsigned char)src[1]) && isxdigit((unsigned char)src[2])) {
            char h[3] = { src[1], src[2], 0 };
            
            *dst++ = (char)strtol(h, NULL, 16);
            src += 3;
        } else if (src[0] == '+') {
            *dst++ = ' ';
            src++;

        } else {
            *dst++ = *src++;
        }
    }

    *dst = '\0';
    return (size_t)(dst - s);
}

/** 안전한 경로 결합 */
static int safe_join_under_base(const char *base, const char *name, char out[PATH_MAX]) {
    char realb[PATH_MAX];

    if (!realpath(base, realb)) {
        return -1;
    }

    char cand[PATH_MAX];
    if (snprintf(cand, sizeof(cand), "%s/%s", base, name) >= (int)sizeof(cand)) {
        return -1;
    }

    char *realc = realpath(cand, NULL);
    if (!realc) {
        return -1;
    }

    size_t bl = strlen(realb);
    int ok = (strncmp(realb, realc, bl) == 0) && (realc[bl] == '/' || realc[bl] == '\0');

    if (ok) {
        strncpy(out, realc, PATH_MAX - 1);
        out[PATH_MAX - 1] = '\0';
    }

    free(realc);
    return ok ? 0 : -1;
}

/** 상태 */
typedef enum {
    S_HANDSHAKE = 0,
    S_READ_REQ,
    S_SEND_HDR,
    S_SEND_FILE,
    S_CLOSING
} conn_state_t;

/** 각 클라이언트 연결 컨텍스트 */
typedef struct conn {
    int          fd;        /** 클라이언트 소켓 파일 디스크립터 */
    SSL         *ssl;       /** OpenSSL SSL 객체 */
    conn_state_t st;        /** 현재 상태 (핸드셰이크/읽기/헤더전송/파일전송/종료) */
    bool         ktls_on;   /** kTLS 활성 여부 */

    /* 요청 버퍼 */
    char   req[REQ_BUFSZ];  /** HTTP 요청 문자열 저장 (8KB) */
    size_t rq_len;          /** 현재까지 읽은 요청 길이 */

    /* 응답 헤더 버퍼 */
    char   hdr[512];        /** HTTP 응답 헤더 저장 */
    size_t hdr_len;         /** 헤더 전체 길이 */
    size_t hdr_off;         /** 헤더 중 이미 전송한 오프셋 */

    /* 파일 송신 */
    int    ffd;             /** 전송할 파일의 파일 디스크립터 */
    off_t  fsize;           /** 파일 전체 크기 */
    off_t  foff;            /** 파일 중 전송 완료한 오프셋 */
    char   disp[NAME_MAX];  /** 파일 이름 (URL 디코딩 후) */

    /* OpenSSL 경로용 송신 버퍼 */
    unsigned char *buf;     /** 파일 읽기용 임시 버퍼 */
    size_t         bufsz;   /** 버퍼 크기 */
} conn_t;

/** 워커 컨텍스트 */
typedef struct {
    pthread_t       th;     /** 워커 스레드 핸들 */
    int             ep;     /* epoll 파일 디스크립터 (이벤트 감시용)*/
    
    /** 연결 큐 (acceptor → worker 전달용) */
    int             qcap;   /** 큐 용량 */
    int            *q;      /** 큐 배열 (클라이언트 fd 저장) */
    int             qh;     /** 큐 헤드 인덱스 */
    int             qt;     /** 큐 테일 인덱스 */
    pthread_mutex_t qmtx;   /** 큐 뮤텍스 */
    pthread_cond_t  qcv;    /** 큐 조건 변수 */
    
    /** 공유 설정 */
    SSL_CTX        *ctx;    /** SSL 컨텍스트 */
    const char     *base_dir;   /** 기본 디렉토리 */

    /** 워커 정보 */
    int             id;     /** 워커 ID */
    int             cpu;    /** 할당된 CPU 번호 */
} worker_t;

/** 연결 정리 */
static void conn_free(conn_t *c) {
    if (!c) {
        return;
    }

    if (c->ffd >= 0) {
        close(c->ffd);
    }

    if (c->ssl) {
        SSL_shutdown(c->ssl);
        SSL_free(c->ssl);
    }

    if (c->fd >= 0) {
        close(c->fd);
    }

    free(c->buf);
    free(c);
}

/** CPU 고정(테스트 실패시 경고만) */
static void pin_self_to_cpu(int cpu) {
    cpu_set_t set;
    CPU_ZERO(&set);

    if (cpu >= 0 && cpu < CPU_SETSIZE) {
        CPU_SET(cpu, &set);

        int rc = pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
        if (rc != 0) {
            fprintf(stderr,
                    "[WARN] pthread_setaffinity_np(cpu=%d) failed: %s\n",
                    cpu, strerror(errno));
        }
    }
}

/** 허용된 CPU 마스크에서 n번째 세트 비트 */
static int pick_nth_allowed_cpu(int n) {
    cpu_set_t allowed;

    /** 마스크 조회 */
    if (sched_getaffinity(0, sizeof(allowed), &allowed) != 0) {
        /** 실패 시 전체 CPU 수로 대체 */
        long c = sysconf(_SC_NPROCESSORS_ONLN);
        if (c <= 0) {
            return 0;
        }
        return n % (int)c;
    }

    int list[CPU_SETSIZE];
    int cnt = 0;

    for (int i = 0; i < CPU_SETSIZE; ++i) {
        /** 허용된 CPU 목록 작성 */
        if (CPU_ISSET(i, &allowed)) {
            list[cnt++] = i;
        }
    }

    if (cnt == 0) {
        return 0;
    }

    return list[n % cnt];
}

/** epoll 재등록 */
static void want_events_from_ssl(conn_t *c, uint32_t *events) {
    /** EPOLLET이 기본값 */
    *events = EPOLLET;

    if (c->st == S_HANDSHAKE) {
        /** 핸드셰이크는 읽기/쓰기 모두 필요 */
        *events |= (EPOLLIN | EPOLLOUT);
        return;
    }

    if (c->st == S_READ_REQ) {
        *events |= EPOLLIN;
    } else {
        *events |= EPOLLOUT;
    }
}

/** kTLS 활성 여부 체크 */
static int ssl_is_ktls_on(SSL *ssl) {
#ifdef OPENSSL_KTLS
    BIO *wbio = SSL_get_wbio(ssl);
    return (wbio && BIO_get_ktls_send(wbio));
#else
    (void)ssl;
    return 0;
#endif
}

/** epoll add/mod (EPOLLET 고정) */
static int add_fd_et(int ep, int fd, uint32_t ev, void *ptr) {
    struct epoll_event e = { .events = ev | EPOLLET, .data.ptr = ptr };
    return epoll_ctl(ep, EPOLL_CTL_ADD, fd, &e);
}

static int mod_fd_et(int ep, int fd, uint32_t ev, void *ptr) {
    struct epoll_event e = { .events = ev | EPOLLET, .data.ptr = ptr };
    return epoll_ctl(ep, EPOLL_CTL_MOD, fd, &e);
}

/** 비동기 TLS 송신 */
static int send_nonblock_tls(conn_t *c, const void *buf, size_t len) {
#if defined(TLS_MODE_OPENSSL)
    int n = SSL_write(c->ssl, buf, (int)len);
    if (n > 0) {
        return n;
    }

    int e = SSL_get_error(c->ssl, n);
    if (e == SSL_ERROR_WANT_WRITE || e == SSL_ERROR_WANT_READ) {
        return 0;
    }
    return -1;

#else
# ifdef OPENSSL_KTLS
    if (c->ktls_on) {
        ssize_t n = send(c->fd, buf, len, MSG_NOSIGNAL);
        if (n > 0) {
            return (int)n;
        }
        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
            return 0;
        }
        return -1;
    }
# endif

    int n = SSL_write(c->ssl, buf, (int)len);
    if (n > 0) {
        return n;
    }

    int e = SSL_get_error(c->ssl, n);
    if (e == SSL_ERROR_WANT_WRITE || e == SSL_ERROR_WANT_READ) {
        return 0;
    }
    return -1;
#endif
}

/** 응답 헤더 플러시 */
static int flush_hdr(conn_t *c) {
    while (c->hdr_off < c->hdr_len) {
        int n = send_nonblock_tls(c,                        
                                  c->hdr + c->hdr_off,          /** 남은 헤더 시작 */
                                  c->hdr_len - c->hdr_off);     /** 남은 헤더 길이 */

        if (n > 0) {                /** 일부 헤더 전송됨 */
            c->hdr_off += (size_t)n;
        } else if (n == 0) {        /** EAGAIN: 송신 버퍼 가득참 */
            return 0;
        } else {                    /** 오류 */
            return -1;
        }
    }
    return 1;
}

/** ex_data 인덱스: base_dir 전달 */
static int g_ssl_ex_base_dir_idx = -1;

/** 파일 오픈 + 헤더 준비 + TCP_CORK=1 */
static int build_and_open_file(conn_t *c) {
    const char *base_dir = SSL_get_ex_data(c->ssl, g_ssl_ex_base_dir_idx);

    char full[PATH_MAX];
    if (safe_join_under_base(base_dir, c->disp, full) < 0) {
        return -1;
    }

    c->ffd = open(full, O_RDONLY | O_CLOEXEC);
    if (c->ffd < 0) {
        return -1;
    }

    struct stat st;
    if (fstat(c->ffd, &st) < 0 || !S_ISREG(st.st_mode)) {
        return -1;
    }

    c->fsize = st.st_size;
    c->foff  = 0;

    int cork = 1;
    setsockopt(c->fd, IPPROTO_TCP, TCP_CORK, &cork, sizeof(cork));

    c->hdr_len = (size_t)snprintf(
        c->hdr, sizeof(c->hdr),
        "HTTP/1.1 200 OK\r\n"
        "Content-Type: application/octet-stream\r\n"
        "Content-Length: %jd\r\n"
        "Content-Disposition: attachment; filename=\"%s\"\r\n"
        "Connection: close\r\n\r\n",
        (intmax_t)c->fsize, c->disp
    );

    c->hdr_off = 0;
    return 0;
}

/** 파일 본문 전송(모드별) */
static int send_file_chunk(conn_t *c) {
#if defined(TLS_MODE_KTLS_SENDFILE)
# ifdef OPENSSL_KTLS

    /** sendfile */
    if (c->ktls_on) {
        while (c->foff < c->fsize) {
            ssize_t n = sendfile(c->fd, c->ffd, &c->foff, (size_t)(c->fsize - c->foff));
            if (n > 0) {    /** 전송 유지 */
                continue;
            }
            if (n == 0) {   /** 전송 완료 */
                break;
            }
            if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) {
                return 0;   /** EAGAIN: 송신 버퍼 가득참 */
            }
            return -1;      /** 오류 */
        }
        return 1;           /** 전송 완료 */
    }
# endif
#endif
    /** OpenSSL SSL_write + 파일 읽기 */
    /** 버퍼 할당 (최초 1회) */
    if (!c->buf) {
        long pg = sysconf(_SC_PAGESIZE);    /** 페이지 크기(보통 4KB) */

        size_t need = IO_BUFSZ;

        /** 
         * 버퍼 크기를 페이지 크기의 배수로 보정
         * - 메모리 낭비 최소화 (마지막 페이지 완전 활용)
         */
        if (need % (size_t)pg) {
            need += (size_t)pg - (need % (size_t)pg); 
        }

        /** 
         * 페이지 경계에 정렬된 메모리 할당
         * - 주소 정렬: TLB 효율 향상 (미미)
         * - 파일 open시 O_DIRECT(DMA) 사용 - 성능 향상 기대 (현재는 미사용)
         *      > 파일 크기, 읽기 횟수, 캐시 사용률, 읽기 방식(순차,랜덤)에 따라 효과 다름
         *      > sendfile은 의미 없음 (버퍼 사용 x)
         */
        if (posix_memalign((void **)&c->buf, (size_t)pg, need) != 0) {
            c->buf = malloc(need);      /** 정렬 실패 시 일반 malloc */
        }
        c->bufsz = need;
    }

    /** 파일 읽기, 전송 */
    for (;;) {
        ssize_t r = read(c->ffd, c->buf, c->bufsz);

        if (r > 0) {
            size_t off = 0;

            /** 읽은 데이터 모두 전송 */
            while (off < (size_t)r) {
                int n = send_nonblock_tls(c, c->buf + off, (size_t)r - off);

                if (n > 0) {
                    off += (size_t)n;
                } else if (n == 0) {       /** 송신 버퍼 부족: 파일 오프셋 되돌리기 */
                    lseek(c->ffd, (off - (size_t)r), SEEK_CUR);
                    return 0;
                } else {                   /** 오류 */
                    return -1;
                }
            }

            c->foff += r;

        } else if (r == 0) {    /** EOF: 파일 전송 완료 */
            return 1;

        } else {
            if (errno == EINTR) {
                continue;   /** 인터럽트 시 재시도 */
            }
            if (errno == EAGAIN || errno == EWOULDBLOCK) {
                return 0;   /** 송신 버퍼 부족 */
            }
            return -1;
        }
    }

    return 0;
}

/** 404 */
static void send_404(conn_t *c) {
    const char *body = "<html><body><h1>404 Not Found</h1></body></html>\n";

    char hdr[256];
    int len = snprintf(
        hdr, sizeof(hdr),
        "HTTP/1.1 404 Not Found\r\n"
        "Content-Type: text/html; charset=utf-8\r\n"
        "Content-Length: %zu\r\n"
        "Connection: close\r\n\r\n",
        strlen(body)
    );

    (void)send_nonblock_tls(c, hdr, (size_t)len);
    (void)send_nonblock_tls(c, body, strlen(body));
}

/** 이벤트 핸들러 */
static void handle_conn_event(worker_t *w, conn_t *c, uint32_t ev) {
    /** 클라이언트의 연결 종료(EPOLLHUP)나 소켓 에러(EPOLLERR) 상태 처리 */
    if (ev & (EPOLLHUP | EPOLLERR)) {
        c->st = S_CLOSING;
    }

    for (;;) {
        if (c->st == S_HANDSHAKE) {
            /** TLS 핸드셰이크 */
            int r = SSL_accept(c->ssl);

            if (r == 1) {
                c->ktls_on = ssl_is_ktls_on(c->ssl);

                /* 핸드셰이크 완료: kTLS 여부 로그 */
                fprintf(stdout, "KTLS=%d fd=%d\n", c->ktls_on ? 1 : 0, c->fd);
                fflush(stdout);

                c->st = S_READ_REQ;

            } else {
                /** TLS 핸드셰이크가 진행 중이거나 에러 */
                int e = SSL_get_error(c->ssl, r);

                /** 수신 데이터가 부족하거나 핸드셰이크 송신 버퍼가 부족할 때*/
                if (e == SSL_ERROR_WANT_READ || e == SSL_ERROR_WANT_WRITE) {
                    uint32_t ne;

                    /** epoll 이벤트 재등록 */
                    want_events_from_ssl(c, &ne);
                    mod_fd_et(w->ep, c->fd, ne, c);

                    return;     /** epoll_wait으로 대기 */
                }

                /** 핸드셰이크 실패 시 */
                fprintf(stdout, "ERROR handshake fd=%d\n", c->fd);
                fflush(stdout);

                c->st = S_CLOSING;
            }
        }


        if (c->st == S_READ_REQ) {
            /** 요청을 다 읽을 때까지 */
            for (;;) {
                ssize_t n = SSL_read(
                    c->ssl,
                    c->req + c->rq_len,           /** 이전에 읽은 위치 다음부터 */
                    sizeof(c->req) - 1 - c->rq_len  /** 남은 버퍼 크기 */
                );

                if (n > 0) {
                    c->rq_len += (size_t)n;
                    c->req[c->rq_len] = '\0';
                } else {
                    int e = SSL_get_error(c->ssl, (int)n);

                    /** 수신 데이터가 부족 */
                    if (e == SSL_ERROR_WANT_READ) {
                        mod_fd_et(w->ep, c->fd, EPOLLIN, c);
                        return;     /** epoll_wait으로 대기 */
                    }
                    /** TLS 레코드 송신 버퍼 부족 */
                    if (e == SSL_ERROR_WANT_WRITE) {
                        mod_fd_et(w->ep, c->fd, EPOLLOUT, c);
                        return;     /** epoll_wait으로 대기 */
                    }

                    /** 클라이언트의 연결 종료나 에러 */
                    if (n == 0) {
                        c->st = S_CLOSING;
                        break;
                    }

                    fprintf(stdout, "ERROR read fd=%d\n", c->fd);
                    fflush(stdout);

                    c->st = S_CLOSING;
                    break;
                }

                /** HTTP 요청 파싱 */
                char method[8]  = { 0 };
                char path[1024] = { 0 };
                char proto[16]  = { 0 };

                if (sscanf(c->req, "%7s %1023s %15s", method, path, proto) >= 2) {
                    if (strcmp(method, "GET") != 0) {
                        send_404(c);
                        c->st = S_CLOSING;
                        break;
                    }

                    const char *p = (path[0] == '/') ? path + 1 : path;

                    strncpy(c->disp, p, sizeof(c->disp) - 1);
                    c->disp[sizeof(c->disp) - 1] = '\0';

                    char *q = strchr(c->disp, '?');
                    if (q) {
                        *q = '\0';
                    }

                    url_decode(c->disp);

                    if (strstr(c->disp, "../") || strchr(c->disp, '\\')) {
                        send_404(c);
                        c->st = S_CLOSING;
                        break;
                    }

                    /** 파일 열고 헤더 생성 */
                    if (build_and_open_file(c) < 0) {
                        send_404(c);
                        c->st = S_CLOSING;
                        break;
                    }

                    /** 어떤 파일을 보낼지 로깅 */
                    fprintf(stdout,
                            "REQUEST fd=%d path=\"%s\" size=%jd\n",
                            c->fd, c->disp, (intmax_t)c->fsize);
                    fflush(stdout);

                    c->st = S_SEND_HDR;
                    break;
                }

                if (c->rq_len == sizeof(c->req) - 1) {
                    send_404(c);
                    c->st = S_CLOSING;
                    break;
                }
            }
        }


        if (c->st == S_SEND_HDR) {
            int r = flush_hdr(c);

            if (r < 0) {
                fprintf(stdout, "ERROR hdr fd=%d\n", c->fd);
                fflush(stdout);
                c->st = S_CLOSING;

            } else if (r == 0) {        /** 송신 버퍼 부족 */
                mod_fd_et(w->ep, c->fd, EPOLLOUT, c);
                return;

            } else {                    /** 헤더 전송 완료 */
                c->st = S_SEND_FILE;
            }
        }


        if (c->st == S_SEND_FILE) {
            int r = send_file_chunk(c);

            if (r < 0) {                /** 파일 전송 오류 */
                fprintf(stdout, "ERROR body fd=%d\n", c->fd);
                fflush(stdout);
                c->st = S_CLOSING;

            } else if (r == 0) {        /** 송신 버퍼 부족 */
                mod_fd_et(w->ep, c->fd, EPOLLOUT, c);
                return;

            } else {                    /** 파일 전송 완료 */
                /** CORK 옵션 해제 */
                int cork = 0;
                setsockopt(c->fd, IPPROTO_TCP, TCP_CORK, &cork, sizeof(cork));

                /** 전송 완료 시점: 정확한 바이트 = 파일 크기 */
                fprintf(stdout,
                        "COMPLETE fd=%d path=\"%s\" bytes=%jd\n",
                        c->fd, c->disp, (intmax_t)c->fsize);
                fflush(stdout);

                c->st = S_CLOSING;
            }
        }

        if (c->st == S_CLOSING) {
            conn_free(c);
            return;
        }
    }
}

/** 워커 스레드 */
static void *worker_main(void *arg) {
    worker_t *w = (worker_t *)arg;

    pin_self_to_cpu(w->cpu);    /** 워커 스레드 CPU 고정 */
    fprintf(stderr, "[INFO] worker#%d pinned to CPU %d\n", w->id, w->cpu);

    struct epoll_event evs[MAX_EVENTS];

    while (!g_stop) {

        /** 1) acceptor → worker 큐 수신 */
        pthread_mutex_lock(&w->qmtx);

        
        /** 큐에서 모든 클라이언트 fd 추출 */
        while (w->qh != w->qt) {
            int cfd = w->q[w->qh];

            /** 가득차면 오래된 fd 드롭 */
            w->qh = (w->qh + 1) % w->qcap;

            pthread_mutex_unlock(&w->qmtx);

            /** 논블로킹 설정 */
            set_nonblock(cfd);

            /** 
             * CORK 설정
             *  - 약 1460바이트 (MTU)
             *  - 200ms 타임아웃
             */
            int cork = 1;
            (void)setsockopt(cfd, IPPROTO_TCP, TCP_CORK, &cork, sizeof(cork));

            /** 송신 버퍼 크기 설정 */
            int sndbuf = 4 * 1024 * 1024; 
            (void)setsockopt(cfd, SOL_SOCKET, SO_SNDBUF, &sndbuf, sizeof(sndbuf));

#ifdef TCP_NOTSENT_LOWAT
            /** 송신되지 않은 데이터 임계치 설정 */
            int lowat = 2 * 1024 * 1024; 
            (void)setsockopt(cfd, IPPROTO_TCP, TCP_NOTSENT_LOWAT, &lowat, sizeof(lowat));
#endif

            /** 
             * VERIFY 
             *  - 소켓 옵션 적용 후 검증 단계
             */
            int v;
            socklen_t l = sizeof(v);

            if (getsockopt(cfd, SOL_SOCKET, SO_SNDBUF, &v, &l) == 0) {
                fprintf(stdout, "SNDBUF=%d\n", v);
            }

#ifdef TCP_NOTSENT_LOWAT
            if (getsockopt(cfd, IPPROTO_TCP, TCP_NOTSENT_LOWAT, &v, &l) == 0) {
                fprintf(stdout, "NOTSENT_LOWAT=%d\n", v);
            }
#endif
            fflush(stdout);

            /** 연결 구조체 할당 및 초기화 */
            conn_t *c = (conn_t *)calloc(1, sizeof(*c));
            c->fd  = cfd;
            c->ffd = -1;
            c->st  = S_HANDSHAKE;

            /** SSL 세션 객체 생성 */
            c->ssl = SSL_new(w->ctx);
            if (!c->ssl) {
                close(cfd);
                free(c);

                pthread_mutex_lock(&w->qmtx);
                continue;
            }

            /** SSL 세션 객체와 소켓 연결 */
            SSL_set_fd(c->ssl, cfd);
            SSL_set_ex_data(c->ssl, g_ssl_ex_base_dir_idx, (void *)w->base_dir);


            /** epoll 이벤트 등록 */
            uint32_t ev = EPOLLIN | EPOLLOUT;       /** TLS 핸드셰이크는 읽기/쓰기 모두 필요 */
            /** EPOLLET(edge-triggered) 등록 */
            if (add_fd_et(w->ep, cfd, ev, c) < 0) {
                conn_free(c);
            }

            pthread_mutex_lock(&w->qmtx);
        }

        pthread_mutex_unlock(&w->qmtx);


        /** 2) 이벤트 처리 */
        int n = epoll_wait(w->ep, evs, MAX_EVENTS, 200);
        /** 인터럽트가 아닌 epoll_wait의 에러이면 워커 종료 */
        if (n < 0) {
            if (errno == EINTR) {
                continue;
            }
            break;
        }

        /** 이벤트 순회 */
        for (int i = 0; i < n; ++i) {
            conn_t *c = (conn_t *)evs[i].data.ptr;
            if (!c) {
                continue;
            }
            handle_conn_event(w, c, evs[i].events);
        }
    }

    return NULL;
}


/** 큐 삽입 */
static void q_push(worker_t *w, int fd) {
    pthread_mutex_lock(&w->qmtx);

    int nxt = (w->qt + 1) % w->qcap;    /** 순환 큐 */

    /** 가득차면 오래된 fd 드롭 */
    if (nxt == w->qh) {
        w->qh = (w->qh + 1) % w->qcap; 
    }

    w->q[w->qt] = fd;
    w->qt = nxt;

    pthread_mutex_unlock(&w->qmtx);
    /** 대기 중인 워커 깨우기 */
    pthread_cond_signal(&w->qcv);
}


/** socket, bind, listen, nonblock 설정 */
static int make_listen(uint16_t port) {
    int fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) {
        die("socket");
    }

    int one = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));

#ifdef SO_REUSEPORT
    setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, &one, sizeof(one));
#endif

    struct sockaddr_in a = { 0 };
    a.sin_family      = AF_INET;
    a.sin_addr.s_addr = htonl(INADDR_ANY);
    a.sin_port        = htons(port);

    if (bind(fd, (struct sockaddr *)&a, sizeof(a)) < 0) {
        die("bind");
    }

    if (listen(fd, 1024) < 0) {
        die("listen");
    }

    /** 논블로킹 설정 */
    set_nonblock(fd);
    return fd;
}

/** main */
int main(int argc, char **argv) {
    /**
     * stdout: line-buffered 
     *   - \n이 있으면 자동 플러시
     *   - fflush(stdout)와 동일
     */
    setvbuf(stdout, NULL, _IOLBF, 0);

    if (argc < 5) {
        fprintf(stderr,
                "Usage: %s <port> <cert.pem> <key.pem> <base-dir> [workers]\n",
                argv[0]);
        return 1;
    }

    uint16_t port      = (uint16_t)atoi(argv[1]);
    const char *cert   = argv[2];
    const char *key    = argv[3];
    const char *base_dir = argv[4];

    /** 워커 인자 미지정 시 온라인 CPU 수로 설정 */
    int workers = (argc >= 6) ? atoi(argv[5]) : (int)sysconf(_SC_NPROCESSORS_ONLN);
    if (workers <= 0) {
        workers = 1;
    }
    if (workers > MAX_WORKERS) {
        workers = MAX_WORKERS;
    }

    /**
     * SIGINT/SIGTERM 핸들러 설정
     *  - g_stop 플래그 설정으로 main/워커 루프 종료
     */
    struct sigaction sa = { 0 };
    sa.sa_handler = on_sigint;
    sigaction(SIGINT, &sa, NULL);
    sigaction(SIGTERM, &sa, NULL);

    /** OpenSSL 초기화 */
    SSL_load_error_strings();
    OpenSSL_add_ssl_algorithms();

    /** SSL_CTX 생성 */
    const SSL_METHOD *m = TLS_server_method();
    SSL_CTX *ctx = SSL_CTX_new(m);
    if (!ctx) {
        die_ssl("SSL_CTX_new");
    }

#ifdef SSL_OP_ENABLE_KTLS
# if defined(TLS_MODE_OPENSSL)
    SSL_CTX_clear_options(ctx, SSL_OP_ENABLE_KTLS);
# else
    SSL_CTX_set_options(ctx, SSL_OP_ENABLE_KTLS);
# endif
#endif

    /**
     * HW kTLS 오프로딩을 위해 TLS 1.2 + ECDHE-RSA-AES128-GCM-SHA256 강제
     * TLS 1.2에서는 set_ciphersuites가 아니라 set_cipher_list 를 써야 함
     */
    if (SSL_CTX_set_min_proto_version(ctx, TLS1_2_VERSION) != 1) {
        die_ssl("min TLS1.2");
    }
    if (SSL_CTX_set_max_proto_version(ctx, TLS1_2_VERSION) != 1) {
        die_ssl("max TLS1.2");
    }
    if (SSL_CTX_set_cipher_list(ctx, "ECDHE-RSA-AES128-GCM-SHA256") != 1) {
        die_ssl("set cipher list");
    }
    if (SSL_CTX_use_certificate_file(ctx, cert, SSL_FILETYPE_PEM) <= 0) {
        die_ssl("use cert");
    }
    if (SSL_CTX_use_PrivateKey_file(ctx, key, SSL_FILETYPE_PEM) <= 0) {
        die_ssl("use key");
    }
    if (!SSL_CTX_check_private_key(ctx)) {
        die_ssl("check key");
    }

    /**
     * SSL ex_data index 생성 
     *  - 세션 별 base_dir 전달용
     *  - base_dir 포인터를 SSL 객체에 저장
     *  - SSL_set_ex_data / SSL_get_ex_data 사용
     */
    g_ssl_ex_base_dir_idx = SSL_get_ex_new_index(0, (void *)"base_dir", NULL, NULL, NULL);


    /** listen 소켓 설정 */
    int lfd = make_listen(port);


    /** 워커 스레드 생성 */
    worker_t *ws = calloc((size_t)workers, sizeof(worker_t));
    /** 워커 별 CPU 할당 */
    for (int i = 0; i < workers; ++i) {
        ws[i].cpu = pick_nth_allowed_cpu(i);
    }

    for (int i = 0; i < workers; ++i) {
        ws[i].ep = epoll_create1(EPOLL_CLOEXEC);            /** epoll 인스턴스 생성 후 FD 등록 */
        if (ws[i].ep < 0) {
            die("epoll_create1");
        }

        ws[i].qcap = 4096;                                   /** 큐 용량 */
        ws[i].q = calloc((size_t)ws[i].qcap, sizeof(int));   /** 큐 배열 */
        ws[i].qh = 0;                                        /** 큐 헤드 인덱스 */
        ws[i].qt = 0;                                        /** 큐 테일 인덱스 */

        pthread_mutex_init(&ws[i].qmtx, NULL);          /** 큐 뮤텍스 초기화 */
        pthread_cond_init(&ws[i].qcv, NULL);            /** 큐 조건 변수 초기화 */

        ws[i].ctx = ctx;                          /** SSL_CTX 공유 */    
        ws[i].base_dir = base_dir;                /** 기본 디렉토리 공유 */
        ws[i].id = i;                             /** 워커 ID */ 


        if (pthread_create(&ws[i].th, NULL, worker_main, &ws[i]) != 0) {
            die("pthread_create");
        }
    }

    fprintf(stderr,
            "[INFO] mode=%s listen=https://0.0.0.0:%u workers=%d (Ctrl-C to stop)\n",
            MODE_NAME, port, workers);

    int rr = 0;         /** 라운드로빈 */

    while (!g_stop) {
        struct sockaddr_in addr;
        socklen_t alen = sizeof(addr);

        int cfd = accept4(lfd, (struct sockaddr *)&addr, &alen, SOCK_NONBLOCK | SOCK_CLOEXEC);
        if (cfd < 0) {
            if (errno == EAGAIN || errno == EWOULDBLOCK) {
                usleep(1000);   /** 폴링 최적화 */
                continue;
            }
            if (errno == EINTR) {
                continue;
            }
            break;
        }

        /** 라운드로빈으로 워커에 연결 전달 */
        q_push(&ws[rr], cfd);
        rr++;

        /** 순환 */
        if (rr == workers) {
            rr = 0;
        }
    }

    close(lfd);

    g_stop = 1;
    for (int i = 0; i < workers; ++i) {
        pthread_join(ws[i].th, NULL);
        close(ws[i].ep);
        free(ws[i].q);
    }

    free(ws);
    SSL_CTX_free(ctx);
    EVP_cleanup();
    return 0;
}
